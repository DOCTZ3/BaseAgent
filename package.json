{
  "name": "base-agent",
  "version": "0.1.0",
  "description": "BaseAgent — PC 端通用 Agent 系统",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "cli": "tsx src/interface/cli.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:mock": "tsx src/test-mock.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.4.2",
    "openai": "^4.56.0",
    "tiktoken": "^1.0.22",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
