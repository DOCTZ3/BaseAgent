# ============================================
# BaseAgent 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值

# ============================================
# 模型配置
# ============================================

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 主模型配置
MAIN_MODEL=deepseek-reasoner
MAIN_TEMPERATURE=0.7
# 单次生成 token 上限（输出长度限制）
MAIN_MAX_TOKENS=8000
MAIN_ENABLE_THINKING=true

# 快速模型配置（可选）
# FAST_MODEL=deepseek-chat
# FAST_PROVIDER=deepseek
# FAST_TEMPERATURE=0.3
# FAST_MAX_TOKENS=4000
# FAST_ENABLE_THINKING=false

# 推理模型配置（可选）
# REASONING_MODEL=deepseek-reasoner
# REASONING_PROVIDER=deepseek
# REASONING_TEMPERATURE=0.5
# REASONING_MAX_TOKENS=8000
# REASONING_ENABLE_THINKING=true

# ============================================
# 执行控制
# ============================================

# 最大工具调用步数
MAX_STEPS=20

# 单次工具执行超时时间（毫秒）
EXECUTION_TIMEOUT=60000

# ============================================
# 上下文管理
# ============================================

# 模型上下文窗口大小（prompt + completion 总容量）
# DeepSeek V4: 1000000 (1M)
# 注意：这是模型的能力上限，不是单次生成上限
# 单次生成上限由 MAIN_MAX_TOKENS 控制
CONTEXT_WINDOW_SIZE=1000000

# 压缩触发阈值（0.0-1.0）
# 推荐 0.7（70%），即 prompt 达到 700K tokens 时触发压缩
# 留 30% 余地（300K）用于：
#   - 新用户消息
#   - 多次工具调用（一个 Turn 内可能有 10+ 次）
#   - 模型生成（最多 8K tokens）
CONTEXT_COMPRESSION_THRESHOLD=0.7

# 压缩时保留的最近轮数
CONTEXT_RECENT_TURNS=10

# 上下文中最多保留的主题数量（时间滑动窗口）
CONTEXT_MAX_TOPICS=10

# 高水位兜底（占窗口比例）。超过它时 CONTEXT_RECENT_TURNS 让位于「不崩」：
# 突破轮次门槛强制压缩，最少保留 1 轮。
# 为什么需要：单轮很大（一轮里连读十几个文件）可能在攒够 N+1 轮之前就撑破窗口，
# 此时常规压缩会因轮次不足一直跳过，直到 API 报错。
# 必须显著高于 CONTEXT_COMPRESSION_THRESHOLD——它是兜底，不是常规触发点
# （配低了代码会自动上调到阈值+0.1 并告警）。
CONTEXT_HIGH_WATER_RATIO=0.9

# 单次工具结果 token 上限
CONTEXT_MAX_DOM_TOKENS=20000       # DOM/无障碍树
CONTEXT_MAX_CONTENT_TOKENS=10000   # 网页正文
CONTEXT_MAX_FILE_TOKENS=10000      # 文件读取

# --- 压缩调用的输出预算 ---
# 留空 = 跟随主模型 MAIN_MAX_TOKENS。压缩用的就是主模型，预算理应同步。
# 注意：推理内容计入输出预算，实测思维链可达 1500+ token，
# 设小了会让思维链吃光额度、正文为空（finish_reason=length → 重试用尽 → 占位摘要）。
# CONTEXT_COMPRESSION_MAX_TOKENS=

# --- 压缩「输入」的逐字段截断上限（字符）---
# 送给压缩模型的每轮轨迹按字段裁剪，防止工具结果（可能是整个文件）撑爆输入。
# 截断保留开头：ok 标志和数据头部都在前面。
# toolResult 最关键——它是摘要的事实来源，设太小摘要会因缺证据而编造。
CONTEXT_CLIP_USER=300              # 用户提问
CONTEXT_CLIP_TOOL_ARGS=120         # 工具入参
CONTEXT_CLIP_TOOL_RESULT=600       # 工具返回（事实来源）
# 最终回答给得比 toolResult 宽：这是模型对工具结果的蒸馏，信息密度更高，
# 同样的输入预算花在这里更划算。实测 20 条真实回答中位 211、p90 950、最长 1016。
CONTEXT_CLIP_ANSWER=1200           # 最终回答（摘要生成用）
CONTEXT_CLIP_ANSWER_BRIEF=120      # 最终回答（主题分析用，只需判意图）

# ============================================
# 重试策略（RetryHandler）
# ============================================
# 只作用于幂等操作:LLM 调用、结构化输出的 JSON 解析/校验。
# 工具执行(写文件、发请求)不走重试,避免重复副作用。

# 最大重试次数（首次调用不计入，3 表示最多请求 4 次）
RETRY_MAX_ATTEMPTS=3

# 退避基数（毫秒）。实际延迟 = baseDelay * 2^(n-1) ± 30% jitter
RETRY_BASE_DELAY=1000

# 单次退避上限（毫秒），防止指数退避把等待拉到分钟级
RETRY_MAX_DELAY=60000

# 可重试错误特征（逗号分隔，留空则用内置表）
# 内置表覆盖：网络错误码(ECONNRESET/ETIMEDOUT/...)、HTTP 429 与 5xx、
# 以及 rate limit / timeout / socket hang up / overloaded 等文本特征
# RETRY_RETRYABLE_ERRORS=ECONNRESET,ETIMEDOUT,429,503

# ============================================
# 安全配置
# ============================================

# 工作区 —— agent 唯一的活动范围，也是唯一需要配置的路径。
# 它同时是三样东西，不再分开配：
#   ① fs 工具的白名单根（SecurityGuard）
#   ② Python 代码的 cwd —— 模型写的相对路径落在这里
#   ③ Python 写边界的允许范围（audit hook）
# 分开配会错位，出现「fs 工具读得到、Python 写不进」这类不报错的不一致。
#
# 留空 = 文件类工具与代码执行全部被拒绝（启动时告警）。
# 刻意不回落到当前目录 —— 那会把整个项目（含 src/ 和 .env）交给模型。
# 归档目录（TRACE_DIR）由框架自动加进可读列表：压缩后模型要 read_file
# 回溯早期对话，读不到等于历史彻底丢失。
#
# 示例: /home/user/workspace
WORKSPACE=

# 是否允许危险工具（写入、删除等）。
# 注：execute_python 已不属于此类 —— 写边界把不可逆操作限制在工作区内，
# 再每次弹确认只会造成确认疲劳（一轮调七八次，用户会条件反射按 y）。
ALLOW_DANGEROUS_TOOLS=false

# ============================================
# 子 Agent（一次性子任务执行器）
# ============================================
# 模型可用 spawn_subagent 把「需要读大量内容才能得出结论」的子任务下放。
# 子 agent 用独立上下文跑，只把最终回答交回主 agent —— 读到的原始内容
# 留在它自己的上下文里，从源头避免主上下文膨胀（比事后压缩更根本）。
#
# 边界：子 agent 继承主 agent 全部工具但拿不到 spawn 自身（结构上无递归）；
# 共享 signal 与 confirm，危险工具仍需用户确认，权限没有放宽。

# 是否注册 spawn_subagent 工具
SUBAGENT_ENABLED=true

# 单个子 agent 的步数预算（子任务通常是「遍历读取」，需求低于主循环）
SUBAGENT_MAX_STEPS=15

# 单次会话内最多 spawn 多少个 —— 防主 agent 连续下放导致成本失控
SUBAGENT_MAX_COUNT=5

# ============================================
# 长期记忆（用户特征）
# ============================================
# 与上下文压缩是**两件事**：压缩让这次会话能继续（做了什么 + 结果，会过期），
# 记忆让下次会话知道你是谁（习惯 / 偏好，跨会话，变化极慢）。
# 混在一起的后果是会话摘要被当长期记忆越攒越多，而真正该记的偏好被压缩掉。
#
# 抽取器**不能删除条目**：它只输出「本区间看到证据的候选」，合并由代码做，
# 默认全部保留。让它输出整张表就会静默抹掉「用户要说中文」这类
# 十轮前定下、本区间没体现的条目 —— 而这种丢失没有任何迹象。
#
# 模型没有维护记忆的工具，只有用户能看（/memory）和清空（/memory clear）。
# 一条错的特征长得和对的一样权威，而它每轮都在注入。

# 是否启用（关掉则不抽取、不注入，零开销）
MEMORY_ENABLED=true

# SQLite 文件位置。**必须在工作区之外** ——
# 放进工作区，模型的代码就能改自己的记忆（与 .sandbox-venv 同一个理由）
MEMORY_DB_PATH=.agent-memory.db

# 每几轮抽一次，同时也是**给抽取器看的轮数**（同一个数）。
#
# 原先还叠了一层 token 增量，实测那是错的：它取的是模型**输出**的增量，
# 而横幅上看到的是上下文水位 —— 同一次会话输出累计 3656、水位涨到 11966，
# 差三倍多，于是「聊了 11k 还没触发」。按轮次计数虽粗但**可预测**。
#
# 不拆成「隔几轮抽」+「看几轮」两个旋钮：拆开会让同一段对话被重复分析，
# 同一条特征反复 hits+1、虚高它的稳定度 —— 而 hits 正是淘汰依据
MEMORY_TURNS_PER_EXTRACTION=3

# 抽取调用的输出上限。思维链计入输出预算，给小了正文会空（与压缩同一个坑）
MEMORY_MAX_TOKENS=2000

# ============================================
# 日志配置
# ============================================

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ============================================
# 可观测 / LLM 调用留痕（TraceRecorder）
# ============================================
# 本地定位真实效果问题用。每次 LLM 调用落一个 call-NNN.json，
# 内含发给 API 的线格式请求 + 原始响应 + 解析后结果；
# 另有 index.jsonl 逐行记摘要，便于快速扫「哪次慢 / 哪次失败」。
#
# 记的是 Adapter 转换之后的线格式（content: null 转换、reasoning_content 回填、
# tool_calls 结构都在那一步成型），而不是内部格式——否则会看漏真正发出去的内容。

# 是否落盘（默认开启，设为 false 关闭）
TRACE_ENABLED=true

# 落盘根目录（项目根下的可见目录），实际路径为 <dir>/<sessionId>/
TRACE_DIR=traces

# 终端是否回显 reasoning 全文（默认只在摘要里标记有无）
TRACE_VERBOSE=false

# ============================================
# CodeAct / Python 沙箱（execute_python）
# ============================================
# 浏览器能力经这里提供，没有独立的 BrowserDriver 或浏览器工具组。
# 理由：browser_get_dom() 这类工具会把整页 HTML（常 500KB~2MB）灌进上下文；
# 而 page.locator('.price').all_inner_texts() 让 HTML 全程留在子进程，
# 只有提取结果回流 —— 筛选发生在沙箱内，不在上下文里。
#
# 沙箱需自行准备依赖：
#   pip install playwright python-docx openpyxl pypdf pandas requests beautifulsoup4
#   playwright install chromium

# 是否注册 execute_python 工具（默认关闭：需先装好 python 环境和依赖库）
PYTHON_ENABLED=false

# **基础**解释器，通常保持 python 即可。
#
# 注意语义：这里不是最终执行代码的解释器 —— 框架启动时会准备沙箱 venv 并改用
# venv 里那个（见下方 SANDBOX_VENV）。这一项只用于「建 venv」和「venv 不可用时回落」。
#
# 之前是让用户直接把它指到 venv 内的解释器，已废弃：每台新机器都要手动建目录、
# 还要按平台写对 Scripts/ 或 bin/，忘了就是**每次** execute_python 都 spawn ENOENT，
# 而模型会以为是自己代码错了（实测踩到）。这三件事都可推导，交给框架做
PYTHON_PATH=python

# --- 沙箱 venv（框架托管，不存在则启动时自动创建）---
#
# 模型装的包落进项目内的 venv，碰不到你的全局环境。
# 实测事故：模型为做 OCR 自己 pip install，顺带把全局的 onnxruntime 升级了，
# 用户事后翻 trace 才发现 —— 那可能悄悄弄坏别的项目。
#
# **venv 和「装包要不要确认」是两件事，都需要**：
#   确认管的是**授权**（这个包该不该装）；venv 管的是**爆炸半径**（装了影响谁）。
#   确认有一件事结构上做不到 —— 它没法把**连带影响**给你看：你批准的是一行
#   `pip install rapidocr_onnxruntime`，实际发生的是 onnxruntime 被升级，
#   而那是 pip 在你点下同意**之后**解析依赖树才算出来的，不在你读的那行字里。
#   且 pip 没有 undo。有 venv，那次批准就变成可撤销的（删掉重建即可）。
#
# 自动创建时带 --system-site-packages：干净 venv 会让上面那批预装库全部消失，
# 而代码里的 pip 已被禁（见 BLOCK_PIP_INSTALL），模型装不回来 —— 沙箱直接瘫。
# 带上它就是「已装的照样 import，新装的落进 venv」。
# 已知代价（摩擦，不是污染）：pip 可能把系统里已有的包判为 already satisfied
# 而不装进 venv，于是你要的版本没到手。装的动作始终落在 venv 里。
#
# 创建失败不阻塞启动：回落到基础解释器并告警（没有隔离仍能干活，
# CLI 起不来就什么都干不了）。
# 设 false = 直接用基础解释器，模型装的包会进全局环境
SANDBOX_VENV=true

# venv 目录（相对路径按**项目根**解析）。
# **必须在 WORKSPACE 之外** —— 放进工作区的话模型的代码能改 venv 自身，
# 隔离就自己交出去了。框架会校验这一点，在工作区内时拒绝使用并告警
# （宁可明说「没有隔离」，不给一个假的）。
# 解释器子路径按平台推导（Scripts/python.exe vs bin/python），不配
SANDBOX_VENV_DIR=.sandbox-venv

# 注：run_command 的 PATH 前置目录取**实际使用的**解释器所在目录，不另配 ——
# 两处各自算必然错位，而错位不报错，只表现成「venv 里装了、代码里 import 不到」

# 注：cwd 与写边界都取 WORKSPACE，不在这里单独配（见上方 WORKSPACE 说明）

# 单次执行超时（ms）。比工具默认超时宽：浏览器启动 + 页面加载本身就要几秒。
# 需要用户手动登录时，让模型用 timeout_ms 参数单独调大，不必改这里
PYTHON_TIMEOUT=120000

# stdout 上限（字节）。这是 CodeAct 唯一必须框架兜底的地方 ——
# 模型很容易写出 print(page.content())，2MB HTML 一次烧掉几十万 token。
# 超限返回 ok:false + 实际体积 + 收窄建议，让模型改成在沙箱内先提取。
# 50KB ≈ 1.2 万 token：够放几百条提取结果，又拦得住整页 HTML
PYTHON_MAX_STDOUT_BYTES=51200

# stderr 上限（字节）。traceback 通常不长
PYTHON_MAX_STDERR_BYTES=8192

# chromium 的 user-data-dir，登录态持久化在这里。
# 框架只提供路径、不解析内容（目录内是 chromium 自己的 SQLite/LevelDB），
# 因此不存在「按站点适配注入格式」的问题 —— cookie 对浏览器就是不透明键值对。
# 该路径会经 BROWSER_PROFILE_DIR 注入子进程，模型代码里读 os.environ 取用。
#
# 同时进 fs 工具的 deny 列表：里面的 cookie 等价于活凭证，被 read_file
# 读进上下文会跟着 trace 落盘。这是软边界（沙箱进程本身必须能读写），
# 配合 prompt 约定 + stdout 上限兜底。
# 不要放在 PYTHON_WORK_DIR 内：那是模型的工作区，混在一起容易被误删/误读
BROWSER_PROFILE_DIR=.browser-profile

# --- 动作空间收敛（CodeAct）---
#
# 代码成为动作空间之后，「代码能做的」不该再占工具位：每个工具都要在**每次调用**
# 的 prompt 里付 schema 成本，而且「工具和等价代码两条路」会让模型的选择不可预测。
#
# 收敛后去掉四个工具，它们各有一行等价代码：
#   get_current_time → datetime.now()      write_file → open(path,"w")
#   list_files       → glob                echo       → print
# 保留 read_file / search_files：它们自带返回量上限，而裸 glob 命中三千个文件、
# 一 print 就撑爆上下文 ——「数据大不大」是领域知识，封在工具里才有效。
#
# 只在 PYTHON_ENABLED=true 时生效：没有代码通道还删工具就是净损失能力。
# 设 false 可退回「工具全开」做对照
CONVERGE_TOOLS=true

# --- 禁止在代码里装包 ---
#
# 实现是给 Python 子进程注入 PIP_NO_INDEX=1（pip 的通用规则：任何长选项都能用
# PIP_<大写、连字符转下划线> 设默认值）。于是 `pip install X` 拿到
# 「No matching distribution found」并返回码 1。
#
# 关键性质：env **向子进程继承**，所以 subprocess 起的新解释器也覆盖得到 ——
# 这正好补上写边界补不了的那块。audit hook 反过来：注册后删不掉，但只管当前进程，
# 模型换个进程就绕过了（实测确认）。两者在「进程边界」这一点上互补。
#
# **它是路牌不是锁**，这点不含糊：传一份清掉该键的 env 给 subprocess 能绕（实测
# 返回码 0，装得上），`pip install https://.../x.whl` 也能绕（直接 URL 不经索引）。
# 它拦的是「没在绕、只是按常规写法办事」的模型 —— 而那正是实测事故的形态。
#
# 为什么要拦：装包不是「多几个文件」而是**远程代码执行** ——
# pip 在安装期就执行 setup.py（PEP 517 后端），而构建隔离恰好跑在放行的 TEMP 里，
# 写边界对它完全无感。配合 typosquatting（抢注 opencv-pythonn 一类近似名），
# 模型凭记忆猜安装名猜错的概率比人打错字高得多。
#
# 装包的正式通道是 run_command（见下），它每次请用户确认、原样显示命令
BLOCK_PIP_INSTALL=true

# ============================================
# 外部命令通道（run_command）
# ============================================
# ⚠️ 这是**唯一没有机制边界**的能力。Python 的写边界是进程内的 audit hook，
# shell 起的进程根本不经过它。安全性全部来自 run_command 的人工确认
# （danger:true，执行前把原样命令给用户看）。同类工具（Claude Code / Codex）
# 也是这个形状 —— 正当的产品决策，但要诚实记账：靠人守，不靠机制守。
#
# 为什么要它 —— 让危险操作**变得可读**：
# execute_python 本来就是危险工具、也在逐次确认，但那是一屏 40 行代码里的
# 第 23 行 pip install，人不会看清包名；单独一行 `pip install pillow` 才会。
# typosquatting 的整个攻击面就是一两个字符的差别，只有原样单独呈现才拦得住。
#
# 两条设计约束，少一条这个工具就失去意义：
#   ① 确认里显示原样命令，不做摘要（摘要成「安装 OCR 库」恰好把攻击藏起来）
#   ② 调用量必须低 —— 确认疲劳是真的：模型拿它去 ls/cat/git status，
#      用户点二十次后就变条件反射，那个拼错一个字母的 pip 也会一起过。
#      提示词里已写明「日常操作写 Python，这个只用于调外部程序」
#
# 子 agent 拿不到它（按工具名排除）：子 agent 的推理过程用户看不到，
# 确认框会凭空冒出来，用户不知道这条命令从哪来、为什么需要，只能盲点。
# 而装包是对整台机器的副作用，该由主 agent 拿着上下文来做决定。

# 是否注册 run_command。**还需要 ALLOW_DANGEROUS_TOOLS=true 才真正生效**
# （它是危险工具，否则调用会被 runner 直接拒，注册了只会让模型白花一步）
SHELL_ENABLED=false

# 单次超时（ms）。比 Python 宽：装大包（torch 一类）几分钟很常见
SHELL_TIMEOUT=300000

# 输出上限（字节）。比 Python 的 50KB 小：命令输出是日志，模型只需要看结论。
# 超限**不判失败** —— npm install 刷几百行是常态，命令本身是成功的
SHELL_MAX_STDOUT_BYTES=16384
SHELL_MAX_STDERR_BYTES=8192

# 注：shell 的 PATH 会前置 PYTHON_PATH 所在目录，不另配。
# 不前置的话 shell 从 PATH 找到的是**全局** pip，装回用户机器上 ——
# venv 隔离就白做了（正是本次要修的东西）。
# env 继承白名单与 Python 执行器共用同一份（sandbox-env.ts）：
# 各写一份的话，Python 那侧费劲不继承 DEEPSEEK_API_KEY、
# 一句 `echo $DEEPSEEK_API_KEY` 就把凭证隔离还回去了

# 注：screenshot / view_image **只在 execute_python 的代码里可调**，没有开关。
# 实测：两条路都开时模型一律直接发 tool_call（那是它更熟的形式），代码那条路
# 根本走不到；把工具那条路关掉之后它立刻改成在代码里调 view_image(...)，
# 连续三轮、一次调两张。留个开关等于维护一个没人该用的模式。
# 工具仍留在注册表里 —— 工具桥的 invoke 要经 runner 按名字查找。

# ============================================
# 视觉插件（VISION_MODEL）
# ============================================
# 视觉是**插件**：配了这一项才有看图能力，没配就没有（也不会暴露看图函数 ——
# 暴露一个必然失败的函数只会让模型白花一步）。
#
# **数据流是「图进视觉模型、文字回主模型」**，不是把图搬进主模型的上下文：
#   模型在代码里调 view_image(path, question=...) → 框架读盘、编码
#   → 发给视觉模型 → 拿回文字观察 → 观察进主上下文
# 所以**主模型是不是多模态与框架无关** —— 这正是把主模型换成强文本模型
# （如 deepseek-v4-pro）时需要的形状。
#
# 为什么不再用 VISION_ENABLED：那是个「我保证主模型能看图」的断言，
# 框架无法验证，填错的后果是运行时 400。改成「配了没有」这个可验证的事实。
#
# 代价（已知并接受）：主模型看不见它没问的东西，追问要重新发一次图；
# 每张图多一次 LLM 调用（延迟 + 成本）。所以工具描述里要求模型务必写 question。
# 收益：**主上下文里再也没有图片** —— 之前实测的「每轮每图累积 200~240 token、
# 历史截图每步重发」整块消失，长会话省得不少。
#
# 留空 = 不启用视觉
VISION_MODEL=

# 视觉模型的 provider / key / baseURL。都可独立配 ——
# 视觉插件很可能来自另一个 provider，这正是「插件」的含义。
# 未给则回落到主 provider 的配置（DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL）。
#
# 注意：VISION_API_KEY 不在 Python 沙箱的 env 继承白名单里，所以沙箱内的代码
# 拿不到它、无法自己调视觉 API —— 必须经工具桥。这是 CodeAct 收敛后
# 工具桥继续存在的理由之一（凭证隔离）
VISION_PROVIDER=deepseek
VISION_API_KEY=
VISION_BASE_URL=

# 低温：看图要的是「图里有什么」这类事实，不是创造性表述
VISION_TEMPERATURE=0.2

# 观察的输出预算。描述一张图够用，又拦得住长篇大论
VISION_MAX_TOKENS=1024

# 默认关：描述一张图不需要思维链，开着纯烧 token
VISION_ENABLE_THINKING=false
