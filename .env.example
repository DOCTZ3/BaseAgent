# ============================================
# DeepSeek API 配置
# ============================================
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# 主模型配置（必需）
# ============================================
MAIN_MODEL=deepseek-v4-flash
MAIN_TEMPERATURE=0.7
MAIN_MAX_TOKENS=4096
MAIN_ENABLE_THINKING=true  # 是否开启推理模式（输出 reasoning_content）

# ============================================
# 快速模型配置（可选，用于简单任务）
# ============================================
# FAST_PROVIDER=deepseek
# FAST_MODEL=deepseek-chat
# FAST_TEMPERATURE=0.3
# FAST_MAX_TOKENS=2048
# FAST_ENABLE_THINKING=false  # 快速模型通常关闭推理以节省 token

# ============================================
# 推理模型配置（可选，用于复杂任务）
# ============================================
# REASONING_PROVIDER=deepseek
# REASONING_MODEL=deepseek-v4-pro
# REASONING_TEMPERATURE=0.9
# REASONING_MAX_TOKENS=8192
# REASONING_ENABLE_THINKING=true  # 推理模型通常开启推理模式
