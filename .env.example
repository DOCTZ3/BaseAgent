# ============================================
# BaseAgent 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值

# ============================================
# 模型配置
# ============================================

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 主模型配置
MAIN_MODEL=deepseek-reasoner
MAIN_TEMPERATURE=0.7
# 单次生成 token 上限（输出长度限制）
MAIN_MAX_TOKENS=8000
MAIN_ENABLE_THINKING=true

# 快速模型配置（可选）
# FAST_MODEL=deepseek-chat
# FAST_PROVIDER=deepseek
# FAST_TEMPERATURE=0.3
# FAST_MAX_TOKENS=4000
# FAST_ENABLE_THINKING=false

# 推理模型配置（可选）
# REASONING_MODEL=deepseek-reasoner
# REASONING_PROVIDER=deepseek
# REASONING_TEMPERATURE=0.5
# REASONING_MAX_TOKENS=8000
# REASONING_ENABLE_THINKING=true

# ============================================
# 执行控制
# ============================================

# 最大工具调用步数
MAX_STEPS=20

# 单次工具执行超时时间（毫秒）
EXECUTION_TIMEOUT=60000

# ============================================
# 上下文管理
# ============================================

# 模型上下文窗口大小（prompt + completion 总容量）
# DeepSeek V4: 1000000 (1M)
# 注意：这是模型的能力上限，不是单次生成上限
# 单次生成上限由 MAIN_MAX_TOKENS 控制
CONTEXT_WINDOW_SIZE=1000000

# 压缩触发阈值（0.0-1.0）
# 推荐 0.7（70%），即 prompt 达到 700K tokens 时触发压缩
# 留 30% 余地（300K）用于：
#   - 新用户消息
#   - 多次工具调用（一个 Turn 内可能有 10+ 次）
#   - 模型生成（最多 8K tokens）
CONTEXT_COMPRESSION_THRESHOLD=0.7

# 压缩时保留的最近轮数
CONTEXT_RECENT_TURNS=10

# 上下文中最多保留的主题数量（时间滑动窗口）
CONTEXT_MAX_TOPICS=10

# 单次工具结果 token 上限
CONTEXT_MAX_DOM_TOKENS=20000       # DOM/无障碍树
CONTEXT_MAX_CONTENT_TOKENS=10000   # 网页正文
CONTEXT_MAX_FILE_TOKENS=10000      # 文件读取

# ============================================
# 重试策略（RetryHandler）
# ============================================
# 只作用于幂等操作:LLM 调用、结构化输出的 JSON 解析/校验。
# 工具执行(写文件、发请求)不走重试,避免重复副作用。

# 最大重试次数（首次调用不计入，3 表示最多请求 4 次）
RETRY_MAX_ATTEMPTS=3

# 退避基数（毫秒）。实际延迟 = baseDelay * 2^(n-1) ± 30% jitter
RETRY_BASE_DELAY=1000

# 单次退避上限（毫秒），防止指数退避把等待拉到分钟级
RETRY_MAX_DELAY=60000

# 可重试错误特征（逗号分隔，留空则用内置表）
# 内置表覆盖：网络错误码(ECONNRESET/ETIMEDOUT/...)、HTTP 429 与 5xx、
# 以及 rate limit / timeout / socket hang up / overloaded 等文本特征
# RETRY_RETRYABLE_ERRORS=ECONNRESET,ETIMEDOUT,429,503

# ============================================
# 安全配置
# ============================================

# 文件系统沙箱路径（逗号分隔）
# 示例: /home/user/workspace,/tmp/sandbox
FS_SANDBOX_PATHS=

# 是否允许危险工具（写入、删除等）
ALLOW_DANGEROUS_TOOLS=false

# ============================================
# 日志配置
# ============================================

# 日志级别: debug | info | warn | error
LOG_LEVEL=info
