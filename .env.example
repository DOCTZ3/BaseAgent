# ============================================
# BaseAgent 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值

# ============================================
# 模型配置
# ============================================

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 主模型配置
MAIN_MODEL=deepseek-reasoner
MAIN_TEMPERATURE=0.7
# 单次生成 token 上限（输出长度限制）
MAIN_MAX_TOKENS=8000
MAIN_ENABLE_THINKING=true

# 快速模型配置（可选）
# FAST_MODEL=deepseek-chat
# FAST_PROVIDER=deepseek
# FAST_TEMPERATURE=0.3
# FAST_MAX_TOKENS=4000
# FAST_ENABLE_THINKING=false

# 推理模型配置（可选）
# REASONING_MODEL=deepseek-reasoner
# REASONING_PROVIDER=deepseek
# REASONING_TEMPERATURE=0.5
# REASONING_MAX_TOKENS=8000
# REASONING_ENABLE_THINKING=true

# ============================================
# 执行控制
# ============================================

# 最大工具调用步数
MAX_STEPS=20

# 单次工具执行超时时间（毫秒）
EXECUTION_TIMEOUT=60000

# ============================================
# 上下文管理
# ============================================

# 模型上下文窗口大小（prompt + completion 总容量）
# DeepSeek V4: 1000000 (1M)
# 注意：这是模型的能力上限，不是单次生成上限
# 单次生成上限由 MAIN_MAX_TOKENS 控制
CONTEXT_WINDOW_SIZE=1000000

# 压缩触发阈值（0.0-1.0）
# 推荐 0.7（70%），即 prompt 达到 700K tokens 时触发压缩
# 留 30% 余地（300K）用于：
#   - 新用户消息
#   - 多次工具调用（一个 Turn 内可能有 10+ 次）
#   - 模型生成（最多 8K tokens）
CONTEXT_COMPRESSION_THRESHOLD=0.7

# 压缩时保留的最近轮数
CONTEXT_RECENT_TURNS=10

# 上下文中最多保留的主题数量（时间滑动窗口）
CONTEXT_MAX_TOPICS=10

# 高水位兜底（占窗口比例）。超过它时 CONTEXT_RECENT_TURNS 让位于「不崩」：
# 突破轮次门槛强制压缩，最少保留 1 轮。
# 为什么需要：单轮很大（一轮里连读十几个文件）可能在攒够 N+1 轮之前就撑破窗口，
# 此时常规压缩会因轮次不足一直跳过，直到 API 报错。
# 必须显著高于 CONTEXT_COMPRESSION_THRESHOLD——它是兜底，不是常规触发点
# （配低了代码会自动上调到阈值+0.1 并告警）。
CONTEXT_HIGH_WATER_RATIO=0.9

# 单次工具结果 token 上限
CONTEXT_MAX_DOM_TOKENS=20000       # DOM/无障碍树
CONTEXT_MAX_CONTENT_TOKENS=10000   # 网页正文
CONTEXT_MAX_FILE_TOKENS=10000      # 文件读取

# --- 压缩调用的输出预算 ---
# 留空 = 跟随主模型 MAIN_MAX_TOKENS。压缩用的就是主模型，预算理应同步。
# 注意：推理内容计入输出预算，实测思维链可达 1500+ token，
# 设小了会让思维链吃光额度、正文为空（finish_reason=length → 重试用尽 → 占位摘要）。
# CONTEXT_COMPRESSION_MAX_TOKENS=

# --- 压缩「输入」的逐字段截断上限（字符）---
# 送给压缩模型的每轮轨迹按字段裁剪，防止工具结果（可能是整个文件）撑爆输入。
# 截断保留开头：ok 标志和数据头部都在前面。
# toolResult 最关键——它是摘要的事实来源，设太小摘要会因缺证据而编造。
CONTEXT_CLIP_USER=300              # 用户提问
CONTEXT_CLIP_TOOL_ARGS=120         # 工具入参
CONTEXT_CLIP_TOOL_RESULT=600       # 工具返回（事实来源）
# 最终回答给得比 toolResult 宽：这是模型对工具结果的蒸馏，信息密度更高，
# 同样的输入预算花在这里更划算。实测 20 条真实回答中位 211、p90 950、最长 1016。
CONTEXT_CLIP_ANSWER=1200           # 最终回答（摘要生成用）
CONTEXT_CLIP_ANSWER_BRIEF=120      # 最终回答（主题分析用，只需判意图）

# ============================================
# 重试策略（RetryHandler）
# ============================================
# 只作用于幂等操作:LLM 调用、结构化输出的 JSON 解析/校验。
# 工具执行(写文件、发请求)不走重试,避免重复副作用。

# 最大重试次数（首次调用不计入，3 表示最多请求 4 次）
RETRY_MAX_ATTEMPTS=3

# 退避基数（毫秒）。实际延迟 = baseDelay * 2^(n-1) ± 30% jitter
RETRY_BASE_DELAY=1000

# 单次退避上限（毫秒），防止指数退避把等待拉到分钟级
RETRY_MAX_DELAY=60000

# 可重试错误特征（逗号分隔，留空则用内置表）
# 内置表覆盖：网络错误码(ECONNRESET/ETIMEDOUT/...)、HTTP 429 与 5xx、
# 以及 rate limit / timeout / socket hang up / overloaded 等文本特征
# RETRY_RETRYABLE_ERRORS=ECONNRESET,ETIMEDOUT,429,503

# ============================================
# 安全配置
# ============================================

# 文件系统沙箱路径（逗号分隔）
# 示例: /home/user/workspace,/tmp/sandbox
FS_SANDBOX_PATHS=

# 是否允许危险工具（写入、删除等）
ALLOW_DANGEROUS_TOOLS=false

# ============================================
# 子 Agent（一次性子任务执行器）
# ============================================
# 模型可用 spawn_subagent 把「需要读大量内容才能得出结论」的子任务下放。
# 子 agent 用独立上下文跑，只把最终回答交回主 agent —— 读到的原始内容
# 留在它自己的上下文里，从源头避免主上下文膨胀（比事后压缩更根本）。
#
# 边界：子 agent 继承主 agent 全部工具但拿不到 spawn 自身（结构上无递归）；
# 共享 signal 与 confirm，危险工具仍需用户确认，权限没有放宽。

# 是否注册 spawn_subagent 工具
SUBAGENT_ENABLED=true

# 单个子 agent 的步数预算（子任务通常是「遍历读取」，需求低于主循环）
SUBAGENT_MAX_STEPS=15

# 单次会话内最多 spawn 多少个 —— 防主 agent 连续下放导致成本失控
SUBAGENT_MAX_COUNT=5

# ============================================
# 日志配置
# ============================================

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ============================================
# 可观测 / LLM 调用留痕（TraceRecorder）
# ============================================
# 本地定位真实效果问题用。每次 LLM 调用落一个 call-NNN.json，
# 内含发给 API 的线格式请求 + 原始响应 + 解析后结果；
# 另有 index.jsonl 逐行记摘要，便于快速扫「哪次慢 / 哪次失败」。
#
# 记的是 Adapter 转换之后的线格式（content: null 转换、reasoning_content 回填、
# tool_calls 结构都在那一步成型），而不是内部格式——否则会看漏真正发出去的内容。

# 是否落盘（默认开启，设为 false 关闭）
TRACE_ENABLED=true

# 落盘根目录（项目根下的可见目录），实际路径为 <dir>/<sessionId>/
TRACE_DIR=traces

# 终端是否回显 reasoning 全文（默认只在摘要里标记有无）
TRACE_VERBOSE=false

# ============================================
# CodeAct / Python 沙箱（execute_python）
# ============================================
# 浏览器能力经这里提供，没有独立的 BrowserDriver 或浏览器工具组。
# 理由：browser_get_dom() 这类工具会把整页 HTML（常 500KB~2MB）灌进上下文；
# 而 page.locator('.price').all_inner_texts() 让 HTML 全程留在子进程，
# 只有提取结果回流 —— 筛选发生在沙箱内，不在上下文里。
#
# 沙箱需自行准备依赖：
#   pip install playwright python-docx openpyxl pypdf pandas requests beautifulsoup4
#   playwright install chromium

# 是否注册 execute_python 工具（默认关闭：需先装好 python 环境和依赖库）
PYTHON_ENABLED=false

# python 可执行文件。用 venv 时指向 venv 里那个（如 .venv/Scripts/python.exe）
PYTHON_PATH=python

# 代码的工作目录（cwd）。模型写的相对路径都落在这里
PYTHON_WORK_DIR=sandbox

# 单次执行超时（ms）。比工具默认超时宽：浏览器启动 + 页面加载本身就要几秒。
# 需要用户手动登录时，让模型用 timeout_ms 参数单独调大，不必改这里
PYTHON_TIMEOUT=120000

# stdout 上限（字节）。这是 CodeAct 唯一必须框架兜底的地方 ——
# 模型很容易写出 print(page.content())，2MB HTML 一次烧掉几十万 token。
# 超限返回 ok:false + 实际体积 + 收窄建议，让模型改成在沙箱内先提取。
# 50KB ≈ 1.2 万 token：够放几百条提取结果，又拦得住整页 HTML
PYTHON_MAX_STDOUT_BYTES=51200

# stderr 上限（字节）。traceback 通常不长
PYTHON_MAX_STDERR_BYTES=8192

# chromium 的 user-data-dir，登录态持久化在这里。
# 框架只提供路径、不解析内容（目录内是 chromium 自己的 SQLite/LevelDB），
# 因此不存在「按站点适配注入格式」的问题 —— cookie 对浏览器就是不透明键值对。
# 该路径会经 BROWSER_PROFILE_DIR 注入子进程，模型代码里读 os.environ 取用。
#
# 同时进 fs 工具的 deny 列表：里面的 cookie 等价于活凭证，被 read_file
# 读进上下文会跟着 trace 落盘。这是软边界（沙箱进程本身必须能读写），
# 配合 prompt 约定 + stdout 上限兜底。
# 不要放在 PYTHON_WORK_DIR 内：那是模型的工作区，混在一起容易被误删/误读
BROWSER_PROFILE_DIR=.browser-profile

# ============================================
# 多模态：图片输入（view_image）
# ============================================
# 模型改不了请求体，所以它无法自己把图片塞进上下文。view_image 就是那条带内信道：
# 模型调它 → 框架读盘编码 → 下一轮注入成 user 消息。模型不需要知道 wire 格式。
#
# 成本上图片是**便宜通道**：每张图 ≤384 token（服务端会先缩放，2000×2000 和
# 5000×5000 消耗相同），而同一页面的 aria_snapshot 文本往往要 1000~3000 token。
# 所以不必劝模型少截图。
#
# 图片作为工具观察进入 Turn.messages，会随对话保留并在压缩后重建。
# 代价是历史截图每步都会重发（append-only 保住 KV cache 前缀，历史 token 走缓存价）；
# 真的累积过多时由已有的压缩机制归档老轮次，不做滑动窗口。
#
# ⚠️ 必须与模型能力匹配：非视觉模型收到图片会返回 400
#    ("This model does not support image")
VISION_ENABLED=false
